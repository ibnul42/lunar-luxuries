# Copy to .env.local and fill in. Never commit real values

# Public site origin, used for metadataBase and absolute OG URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# The API's base URL, /api prefix included. Must match the backend's PORT, and
# the backend's FRONTEND_ORIGIN must name this app in turn — the session cookie
# rides on that pair. Defaults to http://localhost:4000/api when unset.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# The database, auth secrets and transactional email belong to backend/, which
# owns them — see backend/.env.example. Nothing here needs a secret: everything
# in this file ships to the browser.
