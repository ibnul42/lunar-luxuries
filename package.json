{
  "name": "lunar-luxuries",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack e-commerce store on the Organic design system. Root orchestrator — the apps live in frontend/ (and backend/, once it exists).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "setup": "npm install && npm --prefix frontend install",
    "dev": "concurrently -k -n frontend -c cyan \"npm:dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "format": "npm --prefix frontend run format",
    "format:check": "npm --prefix frontend run format:check",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
