// Data model — README §5. Only the auth slice exists so far; add models as the
// phases that need them land, each with its own migration.
//
// Tables and columns are snake_case in Postgres (`@@map` / `@map`) and
// camelCase in TypeScript, so hand-written SQL in pgAdmin reads naturally.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // The API compiles to CommonJS (see tsconfig.json); the generated client has
  // to match or `require()` of it fails at runtime.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // The URL lives in prisma7.config.ts, not here — Prisma 7 moved it.
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN

  @@map("user_role")
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-cased and trimmed — the DTOs normalise before any
  /// query, so this unique index is effectively case-insensitive.
  email           String    @unique
  /// Argon2id. Null for accounts that only ever sign in through OAuth.
  passwordHash    String?   @map("password_hash")
  name            String
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  role            Role      @default(CUSTOMER)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions Session[]

  @@map("users")
}

/// A signed-in browser. The cookie carries a random token; only its SHA-256
/// lands here, so a leaked table cannot be replayed as live sessions.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A message from the storefront's Contact form — the support inbox until a
/// mailer or helpdesk exists to forward it to (README §3).
model ContactMessage {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  /// Lower-cased and trimmed by the DTO, like `User.email`.
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("contact_messages")
}
