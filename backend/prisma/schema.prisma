// Data model — README §5. Payments and OAuth `Account` links are not modelled
// yet; each lands with its own migration when its phase does.
//
// Tables and columns are snake_case in Postgres (`@@map` / `@map`) and
// camelCase in TypeScript, so hand-written SQL in pgAdmin reads naturally.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // The API compiles to CommonJS (see tsconfig.json); the generated client has
  // to match or `require()` of it fails at runtime.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // The URL lives in prisma7.config.ts, not here — Prisma 7 moved it.
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN

  @@map("user_role")
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-cased and trimmed — the DTOs normalise before any
  /// query, so this unique index is effectively case-insensitive.
  email           String    @unique
  /// Argon2id. Null for accounts that only ever sign in through OAuth.
  passwordHash    String?   @map("password_hash")
  name            String
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  role            Role      @default(CUSTOMER)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions            Session[]
  addresses           Address[]
  cart                Cart?
  wishlistItems       WishlistItem[]
  orders              Order[]
  reviews             Review[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  @@map("users")
}

/// A signed-in browser. The cookie carries a random token; only its SHA-256
/// lands here, so a leaked table cannot be replayed as live sessions.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A message from the storefront's Contact form — the support inbox until a
/// mailer or helpdesk exists to forward it to (README §3).
model ContactMessage {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  /// Lower-cased and trimmed by the DTO, like `User.email`.
  email     String
  subject   String?
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

enum CategoryStatus {
  ACTIVE
  HIDDEN

  @@map("category_status")
}

enum ProductStatus {
  ACTIVE
  DRAFT
  OUT_OF_STOCK

  @@map("product_status")
}

enum ReviewStatus {
  PENDING
  PUBLISHED

  @@map("review_status")
}

/// Two levels: a top-level category (Jewelry) and its subcategories
/// (Necklaces). A product belongs to whichever level fits it best.
model Category {
  id          String         @id @default(uuid(7)) @db.Uuid
  slug        String         @unique
  name        String
  description String?
  imageUrl    String?        @map("image_url")
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0) @map("sort_order")
  parentId    String?        @map("parent_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id                  String        @id @default(uuid(7)) @db.Uuid
  slug                String        @unique
  name                String
  description         String
  categoryId          String        @map("category_id") @db.Uuid
  status              ProductStatus @default(DRAFT)
  /// Minor units. What a list shows; each variant carries its own price.
  basePriceCents      Int           @map("base_price_cents")
  compareAtPriceCents Int?          @map("compare_at_price_cents")
  /// "Best selling" on the homepage.
  isFeatured          Boolean       @default(false) @map("is_featured")
  isNewArrival        Boolean       @default(false) @map("is_new_arrival")
  /// What the colour option is called on this product ("Glaze", "Finish").
  colorLabel          String?       @map("color_label")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  variants      ProductVariant[]
  specs         ProductSpec[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  url       String
  alt       String
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

/// The thing that is actually stocked and sold. Every product has at least
/// one; a product without options has exactly one with null `color`/`size`.
/// README §5 sketches `optionValues jsonb` — the design only ever has a colour
/// and a size, so they are typed columns instead.
model ProductVariant {
  id         String  @id @default(uuid(7)) @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  sku        String  @unique
  color      String?
  /// Swatch fill for the colour picker — product data, not a design token.
  colorHex   String? @map("color_hex")
  size       String?
  priceCents Int     @map("price_cents")
  stockQty   Int     @default(0) @map("stock_qty")
  sortOrder  Int     @default(0) @map("sort_order")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

/// One row of the product page's "Details" tab.
model ProductSpec {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  label     String
  value     String
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_specs")
}

model Review {
  id         String       @id @default(uuid(7)) @db.Uuid
  productId  String       @map("product_id") @db.Uuid
  userId     String?      @map("user_id") @db.Uuid
  authorName String       @map("author_name")
  /// 1–5, enforced by the API.
  rating     Int
  body       String
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Customer
// ---------------------------------------------------------------------------

model Address {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// "Home", "Work".
  label      String
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String   @map("postal_code")
  country    String
  phone      String?
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

/// A signed-in visitor's cart is keyed by `userId`; a guest's by the SHA-256
/// of the random token in its `ll_cart` cookie, the same scheme as sessions.
/// Signing in merges the guest cart into the account's.
model Cart {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String?  @unique @map("user_id") @db.Uuid
  tokenHash String?  @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

/// No price snapshot: prices are read live from the variant every time the
/// cart is shown, and recalculated again server-side at checkout.
model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  qty       Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

/// A single-use password reset. Like sessions, only the token's SHA-256 is kept.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum OrderStatus {
  PROCESSING
  SHIPPED
  DELIVERED
  REFUNDED
  CANCELLED

  @@map("order_status")
}

/// Every money column is minor units in `currency`. Addresses are snapshotted
/// as JSON so editing or deleting a saved address never rewrites history.
model Order {
  id              String      @id @default(uuid(7)) @db.Uuid
  /// Customer-facing, e.g. "48291".
  number          String      @unique
  userId          String?     @map("user_id") @db.Uuid
  email           String
  customerName    String      @map("customer_name")
  status          OrderStatus @default(PROCESSING)
  subtotalCents   Int         @map("subtotal_cents")
  shippingCents   Int         @map("shipping_cents")
  taxCents        Int         @default(0) @map("tax_cents")
  totalCents      Int         @map("total_cents")
  currency        String
  shippingAddress Json        @map("shipping_address")
  billingAddress  Json?       @map("billing_address")
  /// Human-readable, e.g. "Cash on delivery". Payments are not modelled until
  /// the provider is chosen (README §10 q1).
  paymentMethod   String      @map("payment_method")
  placedAt        DateTime    @default(now()) @map("placed_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  shipment Shipment?

  @@index([userId])
  @@index([status])
  @@index([placedAt])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(uuid(7)) @db.Uuid
  orderId         String  @map("order_id") @db.Uuid
  variantId       String? @map("variant_id") @db.Uuid
  nameSnapshot    String  @map("name_snapshot")
  /// "Sand · 32oz", or null for a product without options.
  variantSnapshot String? @map("variant_snapshot")
  /// Kept so the line can still link to its product page.
  productSlug     String? @map("product_slug")
  unitPriceCents  Int     @map("unit_price_cents")
  qty             Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Shipment {
  id             String    @id @default(uuid(7)) @db.Uuid
  orderId        String    @unique @map("order_id") @db.Uuid
  carrier        String?
  trackingNumber String?   @map("tracking_number")
  shippedAt      DateTime? @map("shipped_at") @db.Timestamptz(3)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

// ---------------------------------------------------------------------------
// Store
// ---------------------------------------------------------------------------

/// Key/value store settings — README §5 lists the keys. Read and validated
/// through `SettingsService`, never queried raw.
model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("store_settings")
}

/// No double opt-in yet — there is no mailer to send the confirmation, so
/// `confirmedAt` stays null until one exists.
model NewsletterSub {
  id             String    @id @default(uuid(7)) @db.Uuid
  email          String    @unique
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(3)
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("newsletter_subs")
}

/// Who changed what in the admin console.
model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id")
  diff      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
