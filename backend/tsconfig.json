{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2023",
    "lib": ["ES2023"],
    "outDir": "./dist",
    "baseUrl": "./",

    /* Nest's dependency injection reads `design:paramtypes` metadata that only
       these two flags emit. Without them every provider fails to resolve. */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* Nest's own template only sets `strictNullChecks`. The frontend is fully
       strict, so the backend matches rather than being the lax half of the repo. */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "removeComments": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "incremental": true,
    "skipLibCheck": true
  },
  /* prisma7.config.ts is here so the type-aware ESLint config can lint it.
     tsconfig.build.json pins itself back to src/ — see the note there. */
  "include": ["src/**/*", "prisma7.config.ts"],
  "exclude": ["node_modules", "dist"]
}
