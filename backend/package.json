{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "Lunar Luxuries API — NestJS. Owns the database, auth and business logic; frontend/ is the presentation layer.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "eslint": "^9",
    "globals": "^17",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
