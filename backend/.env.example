# Copy to .env.local (or .env) and fill in. Never commit real values.

NODE_ENV="development"

# Port the API listens on. The storefront owns 3000.
PORT="4000"

# Allowed CORS origin. Must match the storefront exactly, scheme and port
# included — the session cookie the API will issue depends on it.
FRONTEND_ORIGIN="http://localhost:3000"

# Arrives with the database pass, not wired yet.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lunar_luxuries"
