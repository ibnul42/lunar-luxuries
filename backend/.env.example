# Copy to .env.local (or .env) and fill in. Never commit real values.

NODE_ENV="development"

# Port the API listens on. The storefront owns 3000.
PORT="4000"

# The storefront's origin, scheme and port included. CORS and the CSRF Origin
# check both allow exactly this, and nothing else may make state-changing calls.
FRONTEND_ORIGIN="http://localhost:3000"

# Required — the API refuses to boot without it. `npm run db:migrate` creates
# the database if it does not exist. URL-encode special characters in the
# password (@ → %40, # → %23, / → %2F).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lunar_luxuries"
